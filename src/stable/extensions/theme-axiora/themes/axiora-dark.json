{
  "name": "Axiora Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1B1E2E",
    "editor.foreground": "#D4D8EE",
    "editorLineNumber.foreground": "#7A80A3",
    "editorLineNumber.activeForeground": "#4FD6D0",
    "editorCursor.foreground": "#4FD6D0",
    "editor.selectionBackground": "#3B3F7A88",
    "editor.lineHighlightBackground": "#171A28",
    "editorIndentGuide.background1": "#262A40",
    "sideBar.background": "#171A28",
    "sideBar.foreground": "#D4D8EE",
    "sideBarSectionHeader.background": "#171A28",
    "activityBar.background": "#141623",
    "activityBar.foreground": "#4FD6D0",
    "activityBar.inactiveForeground": "#7A80A3",
    "activityBarBadge.background": "#5B5FE0",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#141623",
    "titleBar.activeForeground": "#D4D8EE",
    "statusBar.background": "#3A3FB0",
    "statusBar.foreground": "#F2F4FF",
    "statusBar.noFolderBackground": "#3A3FB0",
    "tab.activeBackground": "#1B1E2E",
    "tab.inactiveBackground": "#171A28",
    "tab.activeBorderTop": "#4FD6D0",
    "tab.activeForeground": "#D4D8EE",
    "tab.inactiveForeground": "#7A80A3",
    "editorGroupHeader.tabsBackground": "#171A28",
    "panel.background": "#171A28",
    "panel.border": "#262A40",
    "terminal.background": "#171A28",
    "focusBorder": "#4FD6D099",
    "button.background": "#5B5FE0",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#4FD6D0",
    "input.background": "#141623",
    "input.border": "#262A40",
    "dropdown.background": "#141623",
    "list.activeSelectionBackground": "#3B3F7A88",
    "list.hoverBackground": "#141623",
    "list.inactiveSelectionBackground": "#141623",
    "badge.background": "#5B5FE0",
    "textLink.foreground": "#4FD6D0",
    "progressBar.background": "#4FD6D0",
    "scrollbarSlider.background": "#7A80A333",
    "editorWidget.background": "#171A28",
    "quickInput.background": "#171A28",
    "menu.background": "#171A28",
    "sideBar.border": "#262A40",
    "editorGroup.border": "#262A40",
    "contrastBorder": "#00000000"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6A7194",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#8BD9B4"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F7B27A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6CC4F5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#F2CF7A"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#D4D8EE"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E89BB8"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F2CF7A"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#7A80A3"
      }
    }
  ]
}