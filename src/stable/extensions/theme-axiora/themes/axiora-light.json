{
  "name": "Axiora Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#F6F7FB",
    "editor.foreground": "#2E3248",
    "editorLineNumber.foreground": "#7B819C",
    "editorLineNumber.activeForeground": "#1E9E99",
    "editorCursor.foreground": "#1E9E99",
    "editor.selectionBackground": "#B9BEF266",
    "editor.lineHighlightBackground": "#ECEEF5",
    "editorIndentGuide.background1": "#D6D9E6",
    "sideBar.background": "#ECEEF5",
    "sideBar.foreground": "#2E3248",
    "sideBarSectionHeader.background": "#ECEEF5",
    "activityBar.background": "#E3E6F0",
    "activityBar.foreground": "#1E9E99",
    "activityBar.inactiveForeground": "#7B819C",
    "activityBarBadge.background": "#4F53CF",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#E3E6F0",
    "titleBar.activeForeground": "#2E3248",
    "statusBar.background": "#4F53CF",
    "statusBar.foreground": "#F2F4FF",
    "statusBar.noFolderBackground": "#4F53CF",
    "tab.activeBackground": "#F6F7FB",
    "tab.inactiveBackground": "#ECEEF5",
    "tab.activeBorderTop": "#1E9E99",
    "tab.activeForeground": "#2E3248",
    "tab.inactiveForeground": "#7B819C",
    "editorGroupHeader.tabsBackground": "#ECEEF5",
    "panel.background": "#ECEEF5",
    "panel.border": "#D6D9E6",
    "terminal.background": "#ECEEF5",
    "focusBorder": "#1E9E9999",
    "button.background": "#4F53CF",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#1E9E99",
    "input.background": "#E3E6F0",
    "input.border": "#D6D9E6",
    "dropdown.background": "#E3E6F0",
    "list.activeSelectionBackground": "#B9BEF266",
    "list.hoverBackground": "#E3E6F0",
    "list.inactiveSelectionBackground": "#E3E6F0",
    "badge.background": "#4F53CF",
    "textLink.foreground": "#1E9E99",
    "progressBar.background": "#1E9E99",
    "scrollbarSlider.background": "#7B819C33",
    "editorWidget.background": "#ECEEF5",
    "quickInput.background": "#ECEEF5",
    "menu.background": "#ECEEF5",
    "sideBar.border": "#D6D9E6",
    "editorGroup.border": "#D6D9E6",
    "contrastBorder": "#00000000"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A90A8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#7246C9"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#2E8A62"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#B85C1F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#1F6FB2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#9A6B00"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#2E3248"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#B03A6A"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7246C9"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9A6B00"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#7B819C"
      }
    }
  ]
}