{
  "name": "axiora-local-ai",
  "displayName": "Axiora Local AI",
  "description": "Local-first AI for Axiora: inline completion (Ollama / OpenAI-compatible), checkpoints, agent memory, spec planning, code review and settings sync without a Copilot account.",
  "publisher": "vscode",
  "license": "MIT",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "enabledApiProposals": [
    "chatProvider"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "axiora-local",
        "displayName": "Axiora Local (Ollama / OpenAI-compatible)"
      }
    ],
    "chatParticipants": [
      {
        "id": "axiora.local",
        "name": "axiora",
        "fullName": "Axiora",
        "description": "Local AI (Ollama / your own key): review, specs, memory",
        "isSticky": true,
        "commands": [
          {
            "name": "review",
            "description": "Review uncommitted changes (git diff) locally"
          },
          {
            "name": "spec",
            "description": "Plan a feature: requirements.md, design.md, tasks.md"
          },
          {
            "name": "remember",
            "description": "Save a note to the project memory"
          },
          {
            "name": "memory",
            "description": "Show the project memory"
          },
          {
            "name": "checkpoint",
            "description": "Create a checkpoint of the workspace"
          },
          {
            "name": "regex",
            "description": "Build a regular expression from a description"
          },
          {
            "name": "improve",
            "description": "Rewrite a prompt to be specific and complete"
          },
          {
            "name": "map",
            "description": "Show the repository map (files and symbols)"
          },
          {
            "name": "web",
            "description": "Search the web and answer with sources"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "axiora.ai.toggleInlineCompletion",
        "title": "Toggle Local Inline Completion",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.ai.setApiKey",
        "title": "Set API Key (OpenAI-compatible provider)",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.ai.testConnection",
        "title": "Test Model Connection",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.checkpoint.create",
        "title": "Create Checkpoint",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.checkpoint.restore",
        "title": "Restore Checkpoint...",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.memory.add",
        "title": "Add to Project Memory...",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.memory.open",
        "title": "Open Project Memory",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.spec.new",
        "title": "New Spec (Requirements, Design, Tasks)...",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.review.changes",
        "title": "Review Uncommitted Changes",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.sync.push",
        "title": "Settings Sync: Upload to My Server",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.sync.pull",
        "title": "Settings Sync: Download from My Server",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.sync.setToken",
        "title": "Settings Sync: Set Server Token",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.ai.fixProblem",
        "title": "Fix Problem with AI",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.ai.generateTests",
        "title": "Generate Tests",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.ai.addDocs",
        "title": "Add Documentation Comments",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.ai.explain",
        "title": "Explain Code",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.ai.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Axiora AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "axiora.ai.terminalCommand",
        "title": "Generate Terminal Command from Description...",
        "category": "Axiora AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "axiora.ai.buildRegex",
        "title": "Build Regex from Description...",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.ai.improvePrompt",
        "title": "Improve Prompt...",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.ai.showRepoMap",
        "title": "Show Repository Map",
        "category": "Axiora AI"
      },
      {
        "command": "axiora.debug.continueOthers",
        "title": "Continue All Other Threads",
        "category": "Debug"
      },
      {
        "command": "axiora.debug.pauseOthers",
        "title": "Pause All Other Threads",
        "category": "Debug"
      },
      {
        "command": "axiora.bookmarks.toggle",
        "title": "Toggle Bookmark",
        "category": "Bookmarks"
      },
      {
        "command": "axiora.bookmarks.toggleNamed",
        "title": "Add Named Bookmark...",
        "category": "Bookmarks"
      },
      {
        "command": "axiora.bookmarks.list",
        "title": "Go to Bookmark...",
        "category": "Bookmarks"
      },
      {
        "command": "axiora.bookmarks.clear",
        "title": "Clear All Bookmarks",
        "category": "Bookmarks"
      },
      {
        "command": "axiora.csv.preview",
        "title": "Open as Table",
        "category": "CSV",
        "icon": "$(table)"
      },
      {
        "command": "axiora.http.send",
        "title": "Send Request",
        "category": "HTTP"
      },
      {
        "command": "axiora.edit.rotateSelectionsForward",
        "title": "Rotate Selection Contents Forward",
        "category": "Selection"
      },
      {
        "command": "axiora.edit.rotateSelectionsBackward",
        "title": "Rotate Selection Contents Backward",
        "category": "Selection"
      },
      {
        "command": "axiora.editor.toggleTypewriter",
        "title": "Toggle Typewriter Mode",
        "category": "View"
      },
      {
        "command": "axiora.edit.pasteFromHistory",
        "title": "Paste from Clipboard History...",
        "category": "Edit"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "axiora.review.changes",
          "group": "navigation@90",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.checkpoint.create",
          "group": "z_axiora@1",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.checkpoint.restore",
          "group": "z_axiora@2",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.ai.generateCommitMessage",
          "group": "navigation@1",
          "when": "scmProvider == git"
        }
      ],
      "editor/context": [
        {
          "submenu": "axiora.ai.editorMenu",
          "group": "1_modification@99"
        }
      ],
      "axiora.ai.editorMenu": [
        {
          "command": "axiora.ai.explain",
          "group": "1@1"
        },
        {
          "command": "axiora.ai.fixProblem",
          "group": "1@2"
        },
        {
          "command": "axiora.ai.addDocs",
          "group": "1@3",
          "when": "!editorReadonly"
        },
        {
          "command": "axiora.ai.generateTests",
          "group": "1@4"
        }
      ],
      "terminal/context": [
        {
          "command": "axiora.ai.terminalCommand",
          "group": "0_axiora"
        }
      ],
      "view/title": [
        {
          "command": "axiora.ai.terminalCommand",
          "group": "navigation@0",
          "when": "view == terminal"
        }
      ],
      "debug/callstack/context": [
        {
          "command": "axiora.debug.continueOthers",
          "group": "3_axiora@1",
          "when": "callStackItemType == 'thread' || callStackItemType == 'stackFrame'"
        },
        {
          "command": "axiora.debug.pauseOthers",
          "group": "3_axiora@2",
          "when": "callStackItemType == 'thread' || callStackItemType == 'stackFrame'"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "axiora.bookmarks.toggle",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "axiora.csv.preview",
          "group": "navigation",
          "when": "resourceExtname == .csv || resourceExtname == .tsv"
        }
      ],
      "explorer/context": [
        {
          "command": "axiora.csv.preview",
          "group": "navigation@99",
          "when": "resourceExtname == .csv || resourceExtname == .tsv"
        }
      ],
      "menubar/selection": [
        {
          "command": "axiora.edit.rotateSelectionsForward",
          "group": "3_multi@99"
        }
      ],
      "menubar/edit": [
        {
          "command": "axiora.edit.pasteFromHistory",
          "group": "2_ccp@99"
        }
      ],
      "menubar/view": [
        {
          "command": "axiora.editor.toggleTypewriter",
          "group": "5_editor@99"
        }
      ]
    },
    "configuration": {
      "title": "Axiora Local AI",
      "properties": {
        "axiora.ai.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai"
          ],
          "default": "ollama",
          "description": "Model provider: local Ollama or any OpenAI-compatible server (LM Studio, llama.cpp, vLLM, OpenRouter, OpenAI...)."
        },
        "axiora.ai.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Base URL of the provider. Ollama: http://127.0.0.1:11434. OpenAI-compatible: e.g. https://api.openai.com/v1"
        },
        "axiora.ai.chatModel": {
          "type": "string",
          "default": "qwen2.5-coder:0.5b",
          "description": "Model used for @axiora chat, /review and /spec."
        },
        "axiora.inlineCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show local ghost-text completions while typing (no Copilot account needed)."
        },
        "axiora.inlineCompletion.model": {
          "type": "string",
          "default": "qwen2.5-coder:0.5b",
          "description": "Fill-in-the-middle model used for inline completion."
        },
        "axiora.inlineCompletion.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Delay before requesting a completion."
        },
        "axiora.inlineCompletion.maxTokens": {
          "type": "number",
          "default": 64,
          "description": "Maximum tokens per completion."
        },
        "axiora.checkpoints.autoOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically create a checkpoint (at most every 5 minutes) when files are saved."
        },
        "axiora.memory.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Include .axiora/memory.md in @axiora prompts."
        },
        "axiora.sync.endpoint": {
          "type": "string",
          "default": "",
          "description": "Your own settings-sync server URL (e.g. https://updates.axiora.dev/api/sync). Empty disables sync."
        },
        "axiora.sync.auto": {
          "type": "boolean",
          "default": false,
          "description": "Upload settings automatically when settings.json or keybindings.json change."
        },
        "axiora.context.repoMap": {
          "type": "boolean",
          "default": true,
          "description": "Include a compact repository map (files + top-level symbols) in @axiora prompts. Files matching .axioraignore are excluded."
        },
        "axiora.editor.typewriterMode": {
          "type": "boolean",
          "default": false,
          "description": "Typewriter mode: keep the cursor line vertically centered while typing."
        },
        "axiora.editorconfig.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Apply .editorconfig settings (indentation, line endings, trailing whitespace, final newline) without an extension."
        }
      }
    },
    "submenus": [
      {
        "id": "axiora.ai.editorMenu",
        "label": "Axiora AI"
      }
    ],
    "keybindings": [
      {
        "command": "axiora.ai.terminalCommand",
        "key": "ctrl+alt+k",
        "when": "terminalFocus"
      },
      {
        "command": "axiora.bookmarks.toggle",
        "key": "ctrl+alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "axiora.bookmarks.list",
        "key": "ctrl+alt+j"
      },
      {
        "command": "axiora.http.send",
        "key": "ctrl+alt+r",
        "when": "editorLangId == http"
      },
      {
        "command": "axiora.edit.pasteFromHistory",
        "key": "ctrl+shift+alt+v",
        "when": "editorTextFocus"
      }
    ],
    "languages": [
      {
        "id": "csv",
        "extensions": [
          ".csv"
        ],
        "aliases": [
          "CSV"
        ]
      },
      {
        "id": "tsv",
        "extensions": [
          ".tsv"
        ],
        "aliases": [
          "TSV"
        ]
      },
      {
        "id": "http",
        "extensions": [
          ".http",
          ".rest"
        ],
        "aliases": [
          "HTTP"
        ]
      }
    ]
  }
}