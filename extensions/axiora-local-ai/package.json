    "menus": {
      "scm/title": [
        {
          "command": "axiora.review.changes",
          "group": "navigation@90",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.checkpoint.create",
          "group": "z_axiora@1",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.checkpoint.restore",
          "group": "z_axiora@2",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.ai.generateCommitMessage",
          "group": "navigation@1",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.git.stashStaged",
          "group": "z_axiora@3",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.git.interactiveRebase",
          "group": "5_axiora@3",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.git.interactiveRebase",
          "group": "5_axiora@3",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.shelve.shelve",
          "group": "5_axiora@4",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.shelve.unshelve",
          "group": "5_axiora@5",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.shelve.view",
          "group": "5_axiora@6",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.changelist.commit",
          "group": "5_axiora@7",
          "when": "scmProvider == git"
        }
      ],
      "editor/context": [
        {
          "submenu": "axiora.ai.editorMenu",
          "group": "1_modification@99"
        },
        {
          "command": "axiora.git.blamePrevious",
          "group": "z_git@1",
          "when": "resourceScheme == file && gitOpenRepositoryCount != 0"
        },
        {
          "command": "axiora.db.runQuery",
          "group": "navigation@0",
          "when": "editorLangId == sql"
        },
        {
          "command": "axiora.k8s.apply",
          "group": "z_k8s@1",
          "when": "editorLangId == yaml"
        }
      ],
      "axiora.ai.editorMenu": [
        {
          "command": "axiora.ai.explain",
          "group": "1@1"
        },
        {
          "command": "axiora.ai.fixProblem",
          "group": "1@2"
        },
        {
          "command": "axiora.ai.addDocs",
          "group": "1@3",
          "when": "!editorReadonly"
        },
        {
          "command": "axiora.ai.generateTests",
          "group": "1@4"
        },
        {
          "command": "axiora.ai.fixAllProblems",
          "group": "1@2b"
        }
      ],
      "terminal/context": [
        {
          "command": "axiora.ai.terminalCommand",
          "group": "0_axiora"
        }
      ],
      "debug/callstack/context": [
        {
          "command": "axiora.debug.continueOthers",
          "group": "3_axiora@1",
          "when": "callStackItemType == 'thread' || callStackItemType == 'stackFrame'"
        },
        {
          "command": "axiora.debug.pauseOthers",
          "group": "3_axiora@2",
          "when": "callStackItemType == 'thread' || callStackItemType == 'stackFrame'"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "axiora.bookmarks.toggle",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "axiora.csv.preview",
          "group": "navigation",
          "when": "resourceExtname == .csv || resourceExtname == .tsv"
        },
        {
          "command": "axiora.tasks.showWaves",
          "group": "navigation@50",
          "when": "resourcePath =~ /[\\\\/]\\.axiora[\\\\/](goals|specs)[\\\\/]/"
        },
        {
          "command": "axiora.tasks.startNext",
          "group": "navigation@51",
          "when": "resourcePath =~ /[\\\\/]\\.axiora[\\\\/](goals|specs)[\\\\/]/"
        },
        {
          "command": "axiora.html.preview",
          "group": "navigation",
          "when": "editorLangId == html"
        },
        {
          "command": "axiora.db.runQuery",
          "group": "navigation",
          "when": "editorLangId == sql"
        },
        {
          "command": "axiora.tex.build",
          "group": "navigation",
          "when": "resourceExtname == .tex || resourceExtname == .typ"
        }
      ],
      "explorer/context": [
        {
          "command": "axiora.csv.preview",
          "group": "navigation@99",
          "when": "resourceExtname == .csv || resourceExtname == .tsv"
        },
        {
          "command": "axiora.html.preview",
          "group": "navigation@98",
          "when": "resourceExtname == .html || resourceExtname == .htm"
        },
        {
          "command": "axiora.docker.build",
          "group": "7_docker@1",
          "when": "resourceFilename =~ /^(Dockerfile|Containerfile)(\\..*)?$/"
        },
        {
          "command": "axiora.docker.composeUp",
          "group": "7_docker@2",
          "when": "resourceFilename =~ /^(docker-)?compose.*\\.ya?ml$/"
        },
        {
          "command": "axiora.docker.composeDown",
          "group": "7_docker@3",
          "when": "resourceFilename =~ /^(docker-)?compose.*\\.ya?ml$/"
        },
        {
          "command": "axiora.k8s.apply",
          "group": "7_k8s@1",
          "when": "resourceExtname =~ /\\.ya?ml$/"
        },
        {
          "command": "axiora.ssh.terminal",
          "group": "navigation@99",
          "when": "resourceScheme == axiora-ssh"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "axiora.shelve.shelve",
          "group": "8_axiora@1",
          "when": "scmProvider == git"
        },
        {
          "command": "axiora.changelist.assign",
          "group": "8_axiora@2",
          "when": "scmProvider == git"
        }
      ],
      "file/newFile": []
    },
    "configuration": {
      "title": "Axiora Local AI",
      "properties": {
        "axiora.ai.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai"
          ],
          "default": "ollama",
          "description": "Model provider: local Ollama or any OpenAI-compatible server (LM Studio, llama.cpp, vLLM, OpenRouter, OpenAI...)."
        },
        "axiora.ai.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Base URL of the provider. Ollama: http://127.0.0.1:11434. OpenAI-compatible: e.g. https://api.openai.com/v1"
        },
        "axiora.ai.chatModel": {
          "type": "string",
          "default": "qwen2.5-coder:0.5b",
          "description": "Model used for @axiora chat, /review and /spec."
        },
        "axiora.inlineCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show local ghost-text completions while typing (no Copilot account needed)."
        },
        "axiora.inlineCompletion.model": {
          "type": "string",
          "default": "qwen2.5-coder:0.5b",
          "description": "Fill-in-the-middle model used for inline completion."
        },
        "axiora.inlineCompletion.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Delay before requesting a completion."
        },
        "axiora.inlineCompletion.maxTokens": {
          "type": "number",
          "default": 64,
          "description": "Maximum tokens per completion."
        },
        "axiora.checkpoints.autoOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically create a checkpoint (at most every 5 minutes) when files are saved."
        },
        "axiora.memory.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Include .axiora/memory.md in @axiora prompts."
        },
        "axiora.sync.endpoint": {
          "type": "string",
          "default": "",
          "description": "Your own settings-sync server URL (e.g. https://updates.axiora.dev/api/sync). Empty disables sync."
        },
        "axiora.sync.auto": {
          "type": "boolean",
          "default": false,
          "description": "Upload settings automatically when settings.json or keybindings.json change."
        },
        "axiora.context.repoMap": {
          "type": "boolean",
          "default": true,
          "description": "Include a compact repository map (files + top-level symbols) in @axiora prompts. Files matching .axioraignore are excluded."
        },
        "axiora.editor.typewriterMode": {
          "type": "boolean",
          "default": false,
          "description": "Typewriter mode: keep the cursor line vertically centered while typing."
        },
        "axiora.editorconfig.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Apply .editorconfig settings (indentation, line endings, trailing whitespace, final newline) without an extension."
        },
        "axiora.ai.costPer1kInputTokens": {
          "type": "number",
          "default": 0,
          "description": "Price per 1K input tokens for cost estimates (0 for local models)."
        },
        "axiora.ai.costPer1kOutputTokens": {
          "type": "number",
          "default": 0,
          "description": "Price per 1K output tokens for cost estimates."
        },
        "axiora.lintFix.onSave": {
          "type": "boolean",
          "default": false,
          "description": "After saving, automatically let the AI fix remaining errors in the file (repeats until clean)."
        },
        "axiora.lintFix.maxIterations": {
          "type": "number",
          "default": 3,
          "description": "Maximum fix/re-check passes for the AI lint-fix loop."
        },
        "axiora.keymap": {
          "type": "string",
          "enum": [
            "default",
            "vim",
            "emacs"
          ],
          "default": "default",
          "description": "Built-in keymap: Vim modal editing or Emacs key bindings."
        },
        "axiora.mcpServer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Expose this editor as an MCP server on 127.0.0.1 (tools: open editors, selection, read file, diagnostics, find files, open file, write file)."
        },
        "axiora.mcpServer.port": {
          "type": "number",
          "default": 3917,
          "description": "Port for the editor MCP server."
        },
        "axiora.mcpServer.allowWrites": {
          "type": "boolean",
          "default": false,
          "description": "Allow MCP clients to write files through the editor."
        },
        "axiora.latex.engine": {
          "type": "string",
          "enum": [
            "latexmk",
            "pdflatex",
            "xelatex",
            "lualatex",
            "tectonic"
          ],
          "default": "latexmk",
          "description": "LaTeX build tool."
        },
        "axiora.latex.buildOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Rebuild the PDF on save while its preview is open."
        }
      }
    },
